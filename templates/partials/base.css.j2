{#- Shared print design system. Every visual decision is expressed as a token
    so a brand swap is brand.yaml and nothing else. -#}
@page { size: letter; margin: 0; }

{% for role, spec in fonts.items() %}{% for face in spec.files %}
@font-face {
  font-family: '{{ spec.family }}';
  src: url('{{ face.href }}') format('woff2');
  font-weight: {{ face.weight }};
  font-style: normal;
  font-display: block;
}
{% endfor %}{% endfor %}

:root {
{% for name, value in colors.items() %}  --{{ name }}: {{ value }};
{% endfor %}
  --display: '{{ fonts.display.family }}', {{ fonts.display.stack }};
  --mono: '{{ fonts.mono.family }}', {{ fonts.mono.stack }};
}

* { margin: 0; padding: 0; box-sizing: border-box;
    -webkit-print-color-adjust: exact; print-color-adjust: exact; }

body { font-family: var(--display); color: var(--body); background: var(--paper2); }

.page {
  width: 8.5in; height: 11in; overflow: hidden; position: relative;
  background: var(--paper); page-break-after: always;
}
.page:last-child { page-break-after: auto; }

/* ---- shared type ---- */
.eyebrow {
  font-family: var(--mono); font-size: 8.5pt; letter-spacing: 0.22em;
  text-transform: uppercase; font-weight: 500;
}
.kicker {
  font-family: var(--mono); font-size: 8pt; letter-spacing: 0.14em;
  text-transform: uppercase; font-weight: 500; color: var(--accentInk);
}

/* Accent runs, written as *starred* text in the campaign file. On dark panels
   the bright accent reads; on paper it needs the darker ink variant. */
.ac { color: var(--accent); }
.sheet .ac, .bodygrid .ac { color: var(--accentInk); }

/* ---- hero ---- */
.hero { position: relative; height: {{ hero_height | default('4.15in') }}; background: var(--dark); }
.hero img.photo { position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; object-position: {{ hero_focal | default('center 35%') }}; }
.hero .scrim { position: absolute; inset: 0; background: linear-gradient(178deg,
  color-mix(in srgb, var(--dark) 42%, transparent) 0%,
  color-mix(in srgb, var(--dark) 18%, transparent) 34%,
  color-mix(in srgb, var(--dark) 66%, transparent) 70%,
  color-mix(in srgb, var(--dark) 97%, transparent) 96%); }
.hero .content { position: absolute; inset: 0; padding: 0.5in 0.75in 0.42in;
  display: flex; flex-direction: column; }
.hero .lockup { height: 0.3in; align-self: flex-start; }
.hero .spacer { flex: 1; }
.hero .chip { display: inline-block; align-self: flex-start;
  background: var(--highlight); color: var(--dark);
  font-family: var(--mono); font-size: 8pt; letter-spacing: 0.18em; font-weight: 500;
  padding: 5pt 10pt; border-radius: 3pt; margin-bottom: 12pt; }
.hero h1 { color: #ffffff; font-size: 31pt; line-height: 1.06; font-weight: 700;
  letter-spacing: -0.02em; max-width: 6.6in; }
.hero h1 .ac { color: var(--accent); }
.hero .sub { color: var(--onDark); font-size: 11.5pt; line-height: 1.45;
  margin-top: 9pt; max-width: 6.2in; }

/* ---- feature rows ---- */
.feat { padding: 9.5pt 0; border-bottom: 1px solid var(--rule); }
.feat:last-child { border-bottom: none; }
.feat h3 { color: var(--ink); font-size: 11.5pt; font-weight: 700;
  margin-bottom: 3pt; letter-spacing: -0.01em; }
.feat h3 .k { font-family: var(--mono); color: var(--accentInk); font-size: 8pt;
  letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; margin-right: 7pt; }
.feat p { font-size: 9.5pt; line-height: 1.5; }

/* ---- price ---- */
.price-card { background: var(--dark); border-radius: 10pt; padding: 17pt 18pt 15pt; color: var(--onDark); }
.price-card .was { font-family: var(--mono); color: var(--onDarkDim); font-size: 9.5pt; letter-spacing: 0.06em; }
.price-card .was s { text-decoration-thickness: 1.5pt; }
.price-card .now { display: flex; align-items: baseline; gap: 8pt; margin-top: 4pt; }
.price-card .now .amt { color: var(--accent); font-size: 34pt; font-weight: 700; letter-spacing: -0.02em; }
.price-card .now .lbl { color: var(--onDark); font-size: 10.5pt; font-weight: 600; line-height: 1.2; }
.price-card .how { margin-top: 9pt; padding-top: 9pt; border-top: 1px solid var(--dark3);
  font-size: 9pt; line-height: 1.55; }
.price-card .how b { color: #fff; }
.price-card .alt { margin-top: 10pt; padding-top: 9pt; border-top: 1px solid var(--dark3); }
.price-card .alt .amt2 { color: #fff; font-size: 15pt; font-weight: 700; }
.price-card .alt .lbl2 { color: var(--onDarkDim); font-size: 9pt; margin-top: 2pt; line-height: 1.45; }
.price-negotiable { background: var(--dark); border-radius: 10pt; padding: 17pt 18pt 15pt; color: var(--onDark); }
.price-negotiable .h { color: var(--accent); font-size: 17pt; font-weight: 700; letter-spacing: -0.01em; }
.price-negotiable p { font-size: 9pt; line-height: 1.55; margin-top: 7pt; }

/* ---- aside ---- */
.aside { margin-top: 11pt; background: var(--accentTint); border-radius: 7pt; padding: 11pt 13pt; }
.aside .k { font-family: var(--mono); color: var(--accentDeep); font-size: 7.5pt;
  letter-spacing: 0.18em; font-weight: 500; display: block; margin-bottom: 4pt;
  text-transform: uppercase; }
.aside p { font-size: 8.5pt; color: var(--accentDeep); line-height: 1.5; }

/* ---- footer / CTA bar ---- */
.credits { position: absolute; left: 0.75in; right: 0.75in; bottom: 1.18in;
  color: var(--muted); font-size: 6.5pt; font-family: var(--mono); letter-spacing: 0.04em; }
.cta { position: absolute; left: 0; right: 0; bottom: 0; background: var(--dark);
  padding: 0.26in 0.75in; display: flex; align-items: center; justify-content: space-between; }
.cta .l { padding-right: 14pt; }
.cta .l h3 { color: #fff; font-size: 14.5pt; font-weight: 700; letter-spacing: -0.01em; }
.cta .l p { color: var(--onDarkDim); font-size: 9.5pt; margin-top: 3pt; }
.cta .l p b, .cta .l p a { color: var(--accent); font-weight: 600;
  white-space: nowrap; text-decoration: none; }
.cta .r { display: flex; align-items: center; gap: 14pt; }
.cta img.lk { height: 0.28in; }
.cta .qr { background: #ffffff; border-radius: 6pt; padding: 4pt 4pt 3pt;
  display: flex; flex-direction: column; align-items: center; gap: 2pt; }
.cta .qr img { width: 0.66in; height: 0.66in; display: block; }
.cta .qr span { font-family: var(--mono); font-size: 5.5pt; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--ink); text-align: center; line-height: 1.3; }

/* ---- draft marker ---- */
{% if draft_marker %}
.page::after {
  content: 'DRAFT FOR REVIEW'; position: absolute; top: 46%; left: -6%; right: -6%;
  transform: rotate(-24deg); text-align: center; font-family: var(--mono);
  font-size: 46pt; letter-spacing: 0.2em; font-weight: 500;
  color: color-mix(in srgb, var(--highlight) 22%, transparent); pointer-events: none; z-index: 90;
}
{% endif %}
